# Reflex environment variables. Copy to .env and fill in your keys.

# Meta Model API (Muse Spark 1.3): the supervisor that decides every browser step.
META_API_KEY=LLM|...

# Baseten: Muse Spark Open (meta-models/muse-spark-open-1026) checks every final answer.
# Without this key the answer check is skipped.
BASETEN_API_KEY=...

# Optional: OpenRouter key, only for the experimental hybrid modes (System 1 via Jev).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional settings
# REFLEX_ANSWER_CHECK_MODEL=meta-models/muse-spark-open-1026   # "off" disables the answer check
# REFLEX_BROWSER_LANG=en-US                                     # browser language (default tr-TR)
# REFLEX_STAY_ON_SITE=1                                         # "0" lets the agent jump to guessed websites
